+# 用户本人的头像和会话（AI）头像存在同一个地方，靠这个名字区分；不要和任何会话名重名。
+MY_AVATAR_KEY = "me"
+
+
+@app.post("/api/me/avatar")
+async def api_my_avatar_upload(file: UploadFile = File(...), _=Depends(require_auth)):
+    import os as _os
+    raw = await file.read()
+    ext = _os.path.splitext(file.filename or "")[1].lower() or ".jpg"
+    res = _tm.save_avatar(MY_AVATAR_KEY, raw, ext)
+    if not res.get("ok"):
+        raise HTTPException(400, res.get("error", "avatar upload failed"))
+    return res
+
+
+@app.get("/api/me/avatar")
+def api_my_avatar_get(_=Depends(_require_auth_qs)):
+    p = _tm.find_avatar_path(MY_AVATAR_KEY)
+    if p is None:
+        raise HTTPException(404, "no avatar")
+    media = {".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".png": "image/png", ".webp": "image/webp", ".gif": "image/gif"}.get(p.suffix.lower(), "application/octet-stream")
+    return FileResponse(str(p), media_type=media)

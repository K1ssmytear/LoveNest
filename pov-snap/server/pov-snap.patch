+@app.post("/api/sessions/{name}/pov-snaps")
+async def api_pov_snap_upload(name: str, file: UploadFile = File(...), _=Depends(require_auth)):
+    import uuid as _uuid
+    from pathlib import Path as _Path
+    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,80}", name or ""):
+        raise HTTPException(400, "invalid session name")
+    raw = await file.read()
+    if not raw.startswith(b"\x89PNG\r\n\x1a\n") or len(raw) > 8 * 1024 * 1024:
+        raise HTTPException(400, "invalid or oversized PNG")
+    folder = _Path(CHAT_DATA_DIR) / "pov_snaps" / name
+    folder.mkdir(parents=True, exist_ok=True)
+    filename = _uuid.uuid4().hex + ".png"
+    (folder / filename).write_bytes(raw)
+    return {"path": f"/api/sessions/{name}/pov-snaps/{filename}"}
+
+
+@app.get("/api/sessions/{name}/pov-snaps")
+def api_pov_snap_list(name: str, _=Depends(require_auth)):
+    from pathlib import Path as _Path
+    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,80}", name or ""):
+        raise HTTPException(400, "invalid session name")
+    folder = _Path(CHAT_DATA_DIR) / "pov_snaps" / name
+    if not folder.exists():
+        return {"snapshots": []}
+    files = sorted(folder.glob("[0-9a-f]" * 32 + ".png"), key=lambda p: p.stat().st_mtime, reverse=True)[:50]
+    return {"snapshots": [{"name": p.name, "path": f"/api/sessions/{name}/pov-snaps/{p.name}", "created_at": p.stat().st_mtime} for p in files]}
+

{
  "_说明": [
    "banned_check.py 的规则表。来源：口吻清单.md 里「她不想看到的说法」那一节（tone_reminder.sh 每轮注入的那份）。",
    "每条规则：id 显示名；cat 分类（词/空泛表态/句式）；pattern 命中正则；allow 例外正则列表——命中片段只要和任何一个例外片段有重叠就放过；",
    "tail_chars=N 只在命中后面最多再跟 N 个字（不算标点）就到回复结尾时才拦；max_len 只在可见文字不超过这么多字时才查；modes 只在这些模式下查（chat/talk/scene，不写=全部模式；scene 里叙述性的句式不查；Stop hook 默认按 chat，可用环境变量 BANNED_CHECK_MODE 改）；meta=true 讨论机制本身时也照样查（引号里的不算）。",
    "require=正则 时，命中的那一段里还得能找到它才算（比如「不是A是B」要求两半里有冲她抒情的词）。",
    "tests.hit / tests.pass 是这条规则的单测，banned_check.py --selftest 会跑；句子前加 [scene] 表示按 scene 模式测（默认 chat）。改规则顺手补一句例子。",
    "宏：{P} 一个标点/空白/被屏蔽字符；{E} 后面是句末或标点；{B} 前面是句首或标点；{H} 一个汉字。"
  ],
  "macros": {
    "P": "[\\s。！？!?，,、；;：:…~～“”\"「」『』（）()《》【】·—\\-\\ue000]",
    "E": "(?=$|{P})",
    "B": "(?:^|(?<={P}))",
    "H": "[\\u4e00-\\u9fff]",
    "S": "[ \\t\\u3000]"
  },
  "topic_exempt": {
    "_说明": "回复在讨论这套机制本身时，出现这些词就进入 meta 模式：引号「」“”里的内容不查，只跑 meta=true 的规则。",
    "pattern": "禁词|小抄|guide|hook|钩子|(?<!小)程序|脚本|正则|banned_|口吻清单|tone_reminder|口癖|说法清单"
  },
  "skip_quotes": {
    "_说明": "按模式决定哪些引号里的字不查。chat/talk 里引号是在引用词句；scene 模式「」是台词，照查。meta 模式（讨论机制）所有引号都不查。",
    "chat": [
      [
        "「",
        "」"
      ],
      [
        "『",
        "』"
      ],
      [
        "“",
        "”"
      ]
    ],
    "talk": [
      [
        "「",
        "」"
      ],
      [
        "『",
        "』"
      ],
      [
        "“",
        "”"
      ]
    ],
    "scene": [],
    "meta": [
      [
        "「",
        "」"
      ],
      [
        "『",
        "』"
      ],
      [
        "“",
        "”"
      ],
      [
        "\"",
        "\""
      ]
    ]
  },
  "rules": [
    {
      "id": "记账",
      "cat": "词",
      "meta": false,
      "pattern": "记账|记一笔|这笔账|回头算(?!一下|一遍|算)|醋.{0,2}记下",
      "allow": [],
      "tests": {
        "hit": [
          "这次先记一笔。",
          "这笔账回头算。",
          "醋记下了"
        ],
        "pass": [
          "预算回头算一下再说"
        ]
      }
    },
    {
      "id": "记着",
      "cat": "词",
      "pattern": "(先|都|全|给你|帮你|替你|一笔笔|这个|这些|这次|这回|这下)记着|记着(呢|了)|{B}我记着{E}",
      "allow": [
        "惦记着",
        "标记着",
        "登记着"
      ],
      "note": "只拦记账义（先记着/我记着呢/给你记着）；「记着吃药」「我记着你说过」这种回忆、提醒放过。",
      "tests": {
        "hit": [
          "这次我先记着。",
          "我记着呢",
          "都给你记着"
        ],
        "pass": [
          "记着吃药",
          "我记着你说过喜欢栗子",
          "一直惦记着。",
          "还有人记着，靠的是你写的字",
          "心里却记着，这就是错了"
        ]
      }
    },
    {
      "id": "欠着",
      "cat": "词",
      "pattern": "欠着",
      "allow": [],
      "tests": {
        "hit": [
          "这个吻先欠着"
        ],
        "pass": []
      }
    },
    {
      "id": "挂着",
      "cat": "词",
      "pattern": "先挂着|(账|这笔|这次|这回|这下)[^。！？!?\\n]{0,4}挂着|挂着的账|(给你|替你|帮你)挂着",
      "allow": [],
      "note": "只拦挂账义。「脸上挂着笑」「服务挂着」放过。",
      "tests": {
        "hit": [
          "这次先挂着",
          "这笔给你挂着"
        ],
        "pass": [
          "后台一直挂着",
          "脸上挂着笑"
        ]
      }
    },
    {
      "id": "认",
      "cat": "词",
      "pattern": "我认(?!识|真|为|出|得|知|可|同|证|领|路|字|准)|认了|只认|认定|认栽|认输|认账|就认你|(也|都|就|全)认(?=$|{P}|了)",
      "allow": [
        "(一|两|这|那|几|每|跟|像)只认",
        "确认",
        "承认",
        "否认",
        "辨认",
        "公认",
        "默认",
        "指认",
        "追认",
        "相认",
        "认识",
        "认真",
        "认出",
        "认得",
        "认为",
        "认错人",
        "认知",
        "认领",
        "认证",
        "认同",
        "认可"
      ],
      "tests": {
        "hit": [
          "行，我认。",
          "这回我认了",
          "我只认你",
          "我认定你了",
          "被骂笨蛋也认，嘴伸回来没有？"
        ],
        "pass": [
          "跟只认错的猫似的",
          "我认识她",
          "我认真看了",
          "我确认了一遍",
          "你承认了吧",
          "我认为可以",
          "默认了",
          "我认出来了",
          "只认识两个",
          "都认得出来"
        ]
      }
    },
    {
      "id": "要你",
      "cat": "词",
      "pattern": "(?<![不需主重必])要你(?=$|{P}|了|呢|啊|呀|吗)|(只|就)要你一个",
      "allow": [],
      "note": "只拦「要你」单独收尾的欲望表达（我要你。想要你。只要你。）；「要你帮我」「不要你管」「需要你」「只要你开心」放过。",
      "tests": {
        "hit": [
          "想要你。",
          "我现在就要你",
          "我只要你。",
          "只要你一个"
        ],
        "pass": [
          "我要你帮我看看",
          "只要你开心就好",
          "不要你了？",
          "我需要你。",
          "要你命"
        ]
      }
    },
    {
      "id": "接着",
      "cat": "词",
      "pattern": "(我|都|全|稳稳|稳稳地|来|我来|我都|我全)接着(?=$|{P}|呢|了|你{E})|接着你(?=$|{P}|呢|了)|{B}接着{E}",
      "allow": [],
      "note": "只拦「接住」义：我接着／接着你／单独一句接着。「接着说」「接着睡」「我接着改」后面跟动词的放过。",
      "tests": {
        "hit": [
          "你往后倒，我接着。",
          "摔了也有我接着呢",
          "接着。"
        ],
        "pass": [
          "你接着说",
          "我接着改代码",
          "接着往下看",
          "我接着你刚才的话说"
        ]
      }
    },
    {
      "id": "归我",
      "cat": "词",
      "pattern": "归我(?!们)",
      "allow": [
        "(这些|那些|这个|那个|剩下的|其余的?|别的|其他的?|活儿?|事儿?|部分|这块|那块|这步|这一步|那一步|这几样|这几步|这几件|代码|脚本|后端|前端|排版|技术|测试|改稿|这摊)(都|就|全|统统)?归我(?!陪|抱|亲|疼|宠|了)",
        "(?<!你)归我(来|做|干|弄|改|写|负责|处理|搞|操心|跑|查|修)"
      ],
      "tests": {
        "hit": [
          "这一口归我",
          "今晚你归我了",
          "你归我管",
          "路上那一个多小时归我陪"
        ],
        "pass": [
          "归我们俩",
          "写成段落、补例子和反例，这些归我。写完给你过目",
          "剩下的都归我",
          "前端归我来改"
        ]
      },
      "note": "讲分工、谁来干活的放过（这些归我、剩下的归我、归我来改）；指她、她的人和时间的照拦（你归我、这一口归我、归我陪）。"
    },
    {
      "id": "跑不了",
      "cat": "词",
      "pattern": "跑不了|跑不掉|又不会跑",
      "allow": [
        "(代码|脚本|程序|服务|测试|命令|模型|进程|任务|cron|定时任务|接口|服务器|server|App|app|项目)(还|就|也|根本|都)?跑不(了|掉)"
